# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets — ADMIN_PASSWORD, SESSION_SECRET, DATABASE_URL live here)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local sqlite artifacts (legacy — the app now runs on Postgres/Supabase, but
# these are harmless to keep ignored in case a local db file ever appears)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite
/prisma/*.sqlite3

# private keys / certs (includes the self-signed cert generated for local
# HTTPS testing via `--experimental-https`, under /certificates)
*.pem
*.key
*.crt
*.p12
/certificates/

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log

# Claude Code local (machine-specific permissions, not for sharing)
.claude/settings.local.json
