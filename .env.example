# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Supabase Postgres connection strings — get both from your Supabase project's
# Settings > Database page. DATABASE_URL is the pooled ("Transaction" mode,
# port 6543) connection used at runtime by serverless functions; DIRECT_URL is
# the direct (port 5432) connection Prisma needs for migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Password required to access /admin and make edits. Change this before deploying.
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="change-me"

# Sleeper league to sync teams, draft results, and rosters from (npm run
# sync:sleeper, the "Sync from Sleeper" button on /admin, or the daily cron
# below). Find it in your league's Sleeper URL: sleeper.com/leagues/<LEAGUE_ID>/...
SLEEPER_LEAGUE_ID=""

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it hits
# /api/cron/sleeper-sync on the daily schedule in vercel.json — set this in
# your Vercel project's env vars (Vercel wires the header up automatically
# once the var exists). Generate one with: openssl rand -hex 32
CRON_SECRET=""

# Google Sheet URL (the normal "Share" link is fine) with a "Player Grades" tab
# used to grade rostered players on /teams and linked from /data. Must be
# shared as "Anyone with the link" can view — the server fetches it
# unauthenticated as a CSV export, refreshed at most once an hour.
PLAYER_GRADES_SHEET_URL=""
