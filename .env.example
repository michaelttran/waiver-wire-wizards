# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

DATABASE_URL="file:./dev.db"

# Password required to access /admin and make edits. Change this before deploying.
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="change-me"
