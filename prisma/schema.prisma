// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  // Engine-less client (Wasm query compiler + driver adapter, see
  // lib/prisma.ts) instead of the native Rust "library" engine binary — the
  // binary approach doesn't reliably survive Vercel's serverless bundling
  // with a custom generator output path.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Team {
  id            String            @id @default(cuid())
  // The one place a team's display name lives; every page reads it from here.
  // The Sleeper sync keeps it current unless the commissioner set a custom
  // name in /admin, which locks it until they switch back to Sleeper's.
  name          String
  nameLocked    Boolean           @default(false)
  ownerName     String
  faabStarting  Int               @default(100)
  buyInPaid     Boolean           @default(false)
  playoffPaid   Boolean           @default(false)
  draftPosition Int?
  sleeperUserId String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  faabMoves     FaabTransaction[]
  challengeWins WeeklyChallenge[]
  draftPicks    DraftPick[]
  roster        RosterPlayer[]
}

// Current roster snapshot, replaced wholesale on every Sleeper sync (see
// DraftPick for the same pattern). Distinct from DraftPick, which is a
// permanent record of what was drafted — this tracks who owns a player *now*,
// after waivers/trades have moved things around.
model RosterPlayer {
  id              String   @id @default(cuid())
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId          String
  sleeperPlayerId String
  playerName      String
  playerPosition  String
  nflTeam         String?
  slot            String // "starter" | "bench" | "ir" | "taxi"
  updatedAt       DateTime @updatedAt

  @@unique([teamId, sleeperPlayerId])
}

model DraftPick {
  id              String   @id @default(cuid())
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId          String
  round           Int
  pick            Int
  overall         Int
  playerName      String
  playerPosition  String
  nflTeam         String
  note            String?
  // Sleeper's player id when the pick came from a Sleeper sync; null for
  // picks entered by hand on /admin (those fall back to name matching).
  sleeperPlayerId String?
  createdAt       DateTime @default(now())

  @@unique([overall])
}

// Market ADP frozen at the end of draft season, used by the value grid on
// /draft. Taken once by the Sleeper sync when the table is empty (and on
// demand from /admin) rather than every day, since market ADP keeps drifting
// after the season starts and the grid is about where players went in drafts.
model AdpEntry {
  id              String   @id @default(cuid())
  overall         Int      @unique // 1-based rank by ADP
  adp             Float
  playerName      String
  playerPosition  String
  nflTeam         String?
  sleeperPlayerId String?
  createdAt       DateTime @default(now())
}

// Season-to-date fantasy points under this league's own Sleeper scoring
// settings, rebuilt on every Sleeper sync. Only QB/RB/WR/TE are stored.
model PlayerSeasonPoints {
  sleeperPlayerId String   @id
  playerName      String
  playerPosition  String
  nflTeam         String?
  points          Float
  gamesPlayed     Int
  updatedAt       DateTime @updatedAt
}

// Per-player, per-week usage and box-score stats for every QB/RB/WR/TE in the
// NFL (not just players on a roster in this league) — feeds the NFL Usage
// Explorer on /data. Rebuilt one week at a time from Sleeper's weekly stats
// endpoint, which keys everything by Sleeper's own player id, so the same id
// ties a row back to PlayerSeasonPoints/RosterPlayer elsewhere in the app.
//
// Season totals aren't stored separately — the UI sums these rows for
// weeks 1..statsThroughWeek, so there's one source of truth instead of two
// numbers that can drift apart.
//
// Sleeper's payload has offensive snaps (off_snp / tm_off_snp) and target
// share inputs (rec_tgt, rec_air_yd, team pass_att) but no route-running
// data — routes-run participation isn't in here because no free feed
// publishes it; see the note on the /data page.
model WeeklyPlayerStat {
  id              String   @id @default(cuid())
  sleeperPlayerId String
  playerName      String
  playerPosition  String // QB | RB | WR | TE
  nflTeam         String
  season          String
  week            Int

  snapPct Float? // 100 * offSnaps / teamOffSnaps
  offSnaps      Int?
  teamOffSnaps  Int?

  carries                Int?
  rushYards              Int?
  rushTd                 Int?
  rushYardsAfterContact  Int?

  targets           Int?
  receptions        Int?
  recYards          Int?
  recTd             Int?
  recAirYards       Int? // feeds aDOT (recAirYards / targets)
  targetSharePct    Float? // 100 * targets / team pass attempts
  teamPassAttempts  Int? // the denominator targetSharePct was computed from — stored so a season total can re-derive a weighted share instead of averaging weekly percentages

  passAttempts    Int?
  passCompletions Int?
  passYards       Int?
  passTd          Int?
  interceptions   Int?

  fantasyPoints Float? // scored with this league's own scoring_settings, like PlayerSeasonPoints

  // Who the player's team played that week, the final score, and a
  // quarter-by-quarter breakdown (the scorebox on the Usage Explorer) — all
  // from nflverse (lib/schedule.ts), not Sleeper, which has no schedule or
  // score endpoint. The quarter arrays are empty, not null, when
  // play-by-play doesn't have the game yet; index 4+ is overtime.
  opponent               String?
  isHome                 Boolean?
  teamScore              Int?
  opponentScore          Int?
  teamQuarterScores      Int[]
  opponentQuarterScores  Int[]

  // NFL Next Gen Stats receiving leaderboard (nflverse's ngs_receiving feed),
  // joined in separately by GSIS id after the Sleeper-based sync above
  // creates the row — WR/TE only, NGS doesn't publish these for RB/QB.
  avgCushion           Float? // yards of cushion the defender gave at the snap
  avgSeparation        Float? // yards of separation at the moment of catch/incompletion
  airYardsSharePct     Float? // % of the team's intended air yards this player drew
  yacAboveExpectation  Float? // actual YAC minus NGS's expected YAC, +/-

  updatedAt DateTime @updatedAt

  @@unique([sleeperPlayerId, season, week])
  @@index([nflTeam, season, week])
  @@index([playerPosition, season, week])
}

model FaabTransaction {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  week        Int
  description String
  amount      Int
  createdAt   DateTime @default(now())
}

model WeeklyChallenge {
  id        String   @id @default(cuid())
  week      Int      @unique
  title     String
  criteria  String
  winner    Team?    @relation(fields: [winnerId], references: [id])
  winnerId  String?
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                Int       @id @default(1)
  draftOrderNote    String    @default("Draft order will be posted here once it's set.")
  sleeperLastSynced DateTime?
  adpSnapshotAt     DateTime?
  adpSnapshotNote   String?
  statsThroughWeek  Int?
}

// Generic sliding-window rate limiter, shared across serverless instances via
// the database. `scope` identifies the thing being limited (e.g. "login",
// "sleeper-sync") and `key` identifies who (e.g. an IP address).
model RateLimitAttempt {
  id        String   @id @default(cuid())
  scope     String
  key       String
  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
}

// One row per page view, for the commissioner's Visitors log in /admin.
// Vercel Analytics never exposes IPs, so this is the only place they live.
// Rows older than 30 days are deleted as new ones come in.
model PageVisit {
  id        String   @id @default(cuid())
  path      String
  ip        String
  city      String?
  region    String?
  country   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
}
